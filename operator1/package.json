{
  "name": "operator1",
  "version": "0.1.0",
  "description": "An operator execution layer for reliable automation systems.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
